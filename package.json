{
	"name": "vite-plugin-inject-scripts",
	"version": "1.0.1",
	"description": "",
	"homepage": "https://github.com/otomad/vite-plugin-inject-scripts#readme",
	"bugs": {
		"url": "https://github.com/otomad/vite-plugin-inject-scripts/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/otomad/vite-plugin-inject-scripts.git"
	},
	"license": "MIT",
	"author": "lunate",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"test": "vitest",
		"clear": "rimraf dist",
		"build": "npm run clear && npm run build:tsdown && npm run fmt:dist",
		"build:tsc": "tsc --build",
		"build:tsdown": "tsdown",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"fmt:dist": "oxfmt dist/"
	},
	"devDependencies": {
		"@types/node": "^26.3.0",
		"oxfmt": "^0.59.0",
		"rimraf": "^6.1.3",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"vite-plugin",
		"vite",
		"plugin",
		"inject",
		"inline",
		"vite-plugin-inject-scripts",
		"vite-plugin-inject-script",
		"inject-scripts",
		"inject-script",
		"module"
	],
	"files": [
		"dist"
	],
	"dependencies": {
		"html-minifier-terser": "^7.2.0",
		"js-build-utils": "^1.1.1",
		"lightningcss": "^1.33.0",
		"linkedom": "^0.18.13",
		"oxc-minify": "^0.147.0"
	}
}
